@PACKAGE_INIT@

# SimdFix::SimdFix is the header-only library; SimdFix::Generator is the code
# generator. simdfix_generate() runs the generator over a consumer's FIX specs and
# makes a target to link, which brings in SimdFix::SimdFix too.
include("${CMAKE_CURRENT_LIST_DIR}/SimdFixTargets.cmake")

set_and_check(SIMDFIX_RESOURCE_DIR "@PACKAGE_SIMDFIX_INSTALL_DATADIR@")
include("${CMAKE_CURRENT_LIST_DIR}/SimdFixGenerate.cmake")

check_required_components(SimdFix)
